{
  "name": "skillcard",
  "version": "0.5.0",
  "description": "Spend infrastructure for autonomous machines — Ramp for autonomous work",
  "author": "Arnav Sharma",
  "license": "MIT",
  "keywords": [
    "fintech",
    "spend-management",
    "autonomous-agents",
    "robotics",
    "governance"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/arnavsharmaa/SkillCard.git"
  },
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -n server,client -c cyan,magenta \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "node server/index.js",
    "dev:client": "npm --prefix client run dev",
    "install:all": "npm install && npm --prefix client install",
    "build": "npm --prefix client run build",
    "lint": "eslint .",
    "check": "npm run lint && npm run build && npm test",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.5",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "openai": "^7.34.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^10.0.6",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "js-yaml": "^5.4.3"
  }
}
