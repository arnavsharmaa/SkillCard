# Copy to .env and fill in. The app runs fine WITHOUT a key (canned fallbacks).
OPENAI_API_KEY=

# Optional: force canned reasoning even if a key is present (safe demo mode).
# RUN_STUBBED=1

# Optional: server port (default 3001).
# PORT=3001

# Optional: comma-separated CORS allowlist (default http://localhost:5173).
# CORS_ORIGIN=http://localhost:5173

# Optional: per-IP API rate limit per minute; 0 disables (default 300).
# RATE_LIMIT_RPM=300
